# PostgreSQL Production Credentials (matches config/database.yml)
ARCADE_DB_USER=arcade
ARCADE_DB_PASSWORD=lswebcat6000
ARCADE_DB_HOST=

# Default Admin Account Password (used by rake db:initial_setup)
ADMIN_PASSWORD=your_secure_admin_password

# Rails Encryption & JWT Signing Secret
# Generate a real key by running: bundle exec rails secret
SECRET_KEY_BASE=paste_your_128_character_generated_secret_key_here

# CORS Allowed Frontend URL
FRONTEND_URL=http://localhost:3000
